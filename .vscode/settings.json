{
  "files.associations": {"*.launch.py": "python", "*.msg": "plaintext"},
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {"**/__pycache__": true, "**/.pytest_cache": true},
  "search.exclude": {"**/build": true, "**/install": true, "**/log": true, "**/.venv": true, "**/__pycache__": true},
  "files.watcherExclude": {"**/build/**": true, "**/install/**": true, "**/log/**": true},
  "python.analysis.extraPaths": ["${workspaceFolder}/tracker_TEAM_15"],
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-s", "tests", "-p", "test_*.py", "-v"],
  "[python]": {"editor.tabSize": 4},
  "[yaml]": {"editor.tabSize": 2, "editor.insertSpaces": true},
  "[markdown]": {"editor.wordWrap": "on"}
}
